# Tu Nieto Digital · Variables de entorno (PLANTILLA SIN VALORES)
# 1) Copia este archivo como .env.local  2) Pega tus valores  3) NUNCA subas .env.local a GitHub
# En Vercel se capturan en Settings > Environment Variables.

# Supabase > Project Settings > API (la llave pública puede llamarse "Publishable key" o "anon")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: "Secret key" o "service_role". Nunca debe llevar el prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Tus integraciones > Credenciales de PRUEBA (opcional en esta etapa)
NEXT_PUBLIC_MP_PUBLIC_KEY_PRUEBA=
MP_ACCESS_TOKEN_PRUEBA=
