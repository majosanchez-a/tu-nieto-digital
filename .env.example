# Tu Nieto Digital · Variables de entorno (PLANTILLA SIN VALORES)
# Copia este archivo como .env.local y pega tus valores. NUNCA subas .env.local a GitHub.
# Sin estas variables el sitio funciona en modo demostración con datos de prueba.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales de PRUEBA de Mercado Pago (se usarán al integrar Checkout Pro)
NEXT_PUBLIC_MP_PUBLIC_KEY_PRUEBA=
MP_ACCESS_TOKEN_PRUEBA=

# Opcional: dominio para canonical, sitemap y Open Graph
NEXT_PUBLIC_SITE_URL=https://tu-nieto-digital.vercel.app
